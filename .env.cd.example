# Example environment file for staging/production Docker Compose deployments.
# Copy this file on the server and adjust values for the target environment.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bfs

DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/bfs
DATABASE_URL_SYNC=postgresql://postgres:change-me@db:5432/bfs

SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost,http://localhost:80
MEDIA_ROOT=/app/media
FRONTEND_PORT=80

# Usually set by GitHub Actions deploy job before docker compose pull/up.
# BACKEND_IMAGE=ghcr.io/namorone/bfs-life-backend:staging
# FRONTEND_IMAGE=ghcr.io/namorone/bfs-life-frontend:staging
